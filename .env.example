# map-project-admin 환경변수 예시 (운영 콘솔 JSON API)
#
# 함께 띄울 때는 admin 컨테이너가 map-project-infra 의 공유 ./.env 를 읽는다
# (compose 가 admin 에 필요한 키만 넘긴다). 혼자 띄울 때는 이 파일을 .env 로 복사한다.
# 공유 .env 의 다른 서비스 키는 무시된다(extra="ignore").
# 접두: ADMIN_ = admin 만 읽는 값, MAP_PROJECT_ = 다른 서비스와 같은 값을 함께 읽는 값.
#
# 빈 값(`KEY=`)은 설정하지 않은 것으로 보고 기본값을 쓴다.
# 목록·사전형 키(ADMIN_CORS_ORIGINS·ADMIN_TARGETS·ADMIN_MONITORING_PANELS)는 값을 줄 때 JSON 으로만
# 쓴다(콤마 구분은 기동 오류).

# ── DB ──────────────────────────────────────────────────────────────
# [필수 · 단일 호스트 모드] control 과 기본 대상이 함께 쓰는 DSN.
# hub_data 읽기 + admin_data 소유. 비밀번호는 infra .env 의
# MAP_PROJECT_ADMIN_DB_PASSWORD 와 같아야 한다.
# 형식: postgresql+psycopg://map_admin:<비밀번호>@postgres:5432/map
ADMIN_DATABASE_URL=
ADMIN_DB_TIMEOUT_SEC=5.0

# ── 운영자 인증 ─────────────────────────────────────────────────────
# 최초 계정: 계정이 하나도 없을 때만 아래 값으로 owner 1명을 만든다.
# 비어 있으면 계정이 없는 상태에서 기동을 멈춘다. 비밀번호는 12자 이상을 권한다.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_SESSION_TTL_MIN=720
ADMIN_SESSION_COOKIE_NAME=admin_session
# **로컬 실행용 값이다.** http://127.0.0.1 에서 로그인하려고 false 로 둔다.
# HTTPS 로 외부에 열기 전에는 반드시 true 로 바꾼다(코드 기본값은 true).
ADMIN_SESSION_COOKIE_SECURE=false
# 로그인 시도 제한(모든 프로세스 합산): 창(초)마다 최대 횟수.
ADMIN_LOGIN_MAX_ATTEMPTS=10
ADMIN_LOGIN_WINDOW_SECONDS=300

# [CORS] 화면을 다른 출처에서 띄울 때만 쓴다. nginx 뒤나 Vite 개발 서버(프록시)는
# 브라우저 입장에서 같은 출처라 필요 없다.
# ADMIN_CORS_ORIGINS=["http://localhost:5173"]

# ── 환경 ────────────────────────────────────────────────────────────
# 기본 환경 이름(소문자로 시작, 소문자·숫자·_·- 32자 이하).
ADMIN_ENVIRONMENT=test
# 다른 환경을 함께 관리할 때만 쓴다. 안쪽 키는 아래 환경변수 이름과 같다.
# 필수: ADMIN_USER_BASE_URL, MAP_PROJECT_AGENT_BASE_URL, MAP_PROJECT_HUB_BASE_URL,
#       MAP_PROJECT_INTERNAL_SERVICE_TOKEN. 비밀값은 기본 설정에서 물려받지 않는다.
# 예시와 설명: docs/architecture.md "실행 모드"
# ADMIN_TARGETS={}

# ── 위임·헬스 대상(내부 네트워크의 서비스 이름:포트) ────────────────
ADMIN_USER_BASE_URL=http://user:8080
MAP_PROJECT_AGENT_BASE_URL=http://agent:8000
MAP_PROJECT_HUB_BASE_URL=http://hub:8000
# 비우면 라우팅 헬스·점검을 건너뛴다(미구성으로 표시).
MAP_PROJECT_OSRM_FOOT_BASE_URL=http://osrm-foot:5000
MAP_PROJECT_OSRM_BICYCLE_BASE_URL=http://osrm-bicycle:5000

# ── 내부 토큰 ───────────────────────────────────────────────────────
# 서비스 사이의 일반 내부 토큰. admin 은 이 토큰으로 관리 호출을 보내지 않는다 —
# 관리 전용 토큰이 이 값과 같으면 거부하는 기준이고, 대상 환경 설정의 필수 키다.
MAP_PROJECT_INTERNAL_SERVICE_TOKEN=
# 관리 전용 토큰. 비었거나 위 토큰·서로와 같으면 회원·허브 관리 호출을 보내지 않는다.
# 받는 쪽(user·hub)에도 같은 값을 넣는다.
MAP_PROJECT_USER_ADMIN_INTERNAL_TOKEN=
MAP_PROJECT_HUB_ADMIN_INTERNAL_TOKEN=

# ── Redis 진단(읽기 전용) ───────────────────────────────────────────
ADMIN_REDIS_URL=redis://redis:6379
# 논리 DB 번호와 스트림 이름 — 정의 서비스(agent·hub·user)와 같은 값이어야 한다.
MAP_PROJECT_REDIS_DB_STREAMS=2
MAP_PROJECT_REDIS_DB_RATELIMIT=3
MAP_PROJECT_REDIS_DB_HUB_CACHE=4
ADMIN_STREAM_DONE=agent:jobs:done
ADMIN_STREAM_STATUS=agent:jobs:status
MAP_PROJECT_STREAM_DLQ=agent:jobs:done:dlq
MAP_PROJECT_STREAM_GROUP=bff-result

# ── 외부 API(상태 표시·수동 점검) ───────────────────────────────────
# 자기 키를 넣었을 때만, 화면에서 점검 버튼을 누를 때 1회 호출한다(키 주인의 쿼터 사용).
# 자동 새로고침은 외부 API 를 부르지 않는다. 화면에는 앞 4자·뒤 2자만 보인다.
MAP_PROJECT_GEMINI_API_KEY=
MAP_PROJECT_KAKAO_REST_API_KEY=
MAP_PROJECT_KMA_SERVICE_KEY=
MAP_PROJECT_TOUR_API_SERVICE_KEY=
MAP_PROJECT_NAVER_CLIENT_ID=
MAP_PROJECT_NAVER_CLIENT_SECRET=
ADMIN_GEMINI_MODELS_URL=https://generativelanguage.googleapis.com/v1beta/models
# 개요 화면의 Gemini 일일 사용량 표시용 상한(agent 의 상한과 같은 값).
MAP_PROJECT_GEMINI_RPD_CAP=200

# ── 타임아웃(초) ────────────────────────────────────────────────────
ADMIN_HEALTH_TIMEOUT_SEC=3.0
ADMIN_GEMINI_TIMEOUT_SEC=5.0
ADMIN_REDIS_TIMEOUT_SEC=2.0
ADMIN_INTERNAL_TIMEOUT_SEC=5.0
ADMIN_EXTERNAL_PROBE_TIMEOUT_SEC=6.0

# ── DB 뷰어(hub_data) ───────────────────────────────────────────────
ADMIN_DB_PAGE_SIZE_DEFAULT=50
ADMIN_DB_PAGE_SIZE_MAX=500
ADMIN_DB_EXPORT_MAX_ROWS=50000

# ── 모니터링 연동 슬롯(선택) ────────────────────────────────────────
# Grafana·Prometheus 등을 화면에 iframe·링크로 연결한다. JSON 배열 1줄, 주소는 http(s) 만.
# ADMIN_MONITORING_PANELS=[{"title":"Grafana","url":"http://127.0.0.1:3000/","embed":true,"height":460},{"title":"Prometheus","url":"http://127.0.0.1:9090","embed":false}]

# ── 중앙 모드(선택) ─────────────────────────────────────────────────
# 계정·세션·감사를 전용 control DB 에 둔다. 설정하면 기본 환경을 포함한 모든 대상을
# ADMIN_TARGETS 에 적어야 하고, ADMIN_DATABASE_URL 은 쓰지 않는다(대상별 DSN 은 선택).
# 준비 순서: scripts/bootstrap-control-db.sql → 일회성 alembic upgrade head → scripts/grant-control-runtime.sql
# ADMIN_CONTROL_DATABASE_URL=postgresql+psycopg://map_admin_runtime:<비밀번호>@<control-db>:5432/<db>
# 마이그레이션 계정 DSN 은 일회성 마이그레이션 작업에만 준다. 서빙 프로세스에는 넣지 않는다.
# ADMIN_CONTROL_MIGRATION_DATABASE_URL=
# auto(기본) = 단일 호스트 모드에서만 기동 때 마이그레이션. 중앙 모드 서빙은 false.
# ADMIN_RUN_MIGRATIONS=false
